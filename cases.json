      "clientVersion": "fleshtimer/0.1 (macos)",
      "method": "PUT",
      "expected": {
        "level": "none",
        "refuse": false,
        "headers": {}
      }
    },
    {
      "name": "only minimum: below it is required",
      "policy": [
        {
          "app": "fleshtimer",
          "platform": "macos",
          "minimum": "1.0"
        }
      ],
      "clientVersion": "fleshtimer/0.9 (macos)",
      "method": "PUT",
      "expected": {
        "level": "required",
        "refuse": true,
        "headers": {
          "X-Client-Upgrade": "required"
        },
        "body": {
          "error": "upgrade_required",
          "message": "This version of the app is no longer supported. Please update."
        }
      }
    },
    {
      "name": "only minimum: at it is none",
      "policy": [
        {
          "app": "fleshtimer",
          "platform": "macos",
          "minimum": "1.0"
        }
      ],
      "clientVersion": "fleshtimer/1.0 (macos)",
      "method": "PUT",
      "expected": {
        "level": "none",
        "refuse": false,
        "headers": {}
      }
    },
    {
      "name": "only recommended, no url",
      "policy": [
        {
          "app": "fleshtimer",
          "platform": "macos",
          "recommended": "1.5"
        }
      ],
      "clientVersion": "fleshtimer/1.0 (macos)",
      "method": "GET",
      "expected": {
        "level": "recommended",
        "refuse": false,
        "headers": {
          "X-Client-Upgrade": "recommended"
        }
      }
    },
    {
      "name": "recommended below minimum: minimum wins",
      "policy": [
        {
          "app": "fleshtimer",
          "platform": "macos",
          "minimum": "2.0",
          "recommended": "1.0"
        }
      ],
      "clientVersion": "fleshtimer/1.5 (macos)",
      "method": "GET",
      "expected": {
        "level": "required",
        "refuse": false,
        "headers": {
          "X-Client-Upgrade": "required"
        }
      }
    },
    {
      "name": "platforms are separate entries",
      "policy": [
        {
          "app": "fleshtimer",
          "platform": "macos",
          "minimum": "1.2.0",
          "recommended": "1.4.0",
          "upgradeUrl": "https://apps.apple.com/app/id6830173151"
        },
        {
          "app": "fleshtimer",
          "platform": "ios",
          "minimum": "3.0"
        }
      ],
      "clientVersion": "fleshtimer/1.4.0 (macos)",
      "method": "PUT",
      "expected": {
        "level": "none",
        "refuse": false,
        "headers": {}
      }
    }
  ],
  "atLeast": [
    {
      "clientVersion": "fleshtimer/1.3.0 (macos)",
      "version": "1.3",
      "expected": true
    },
    {
      "clientVersion": "fleshtimer/1.2.9 (macos)",
      "version": "1.3",
      "expected": false
    },
    {
      "clientVersion": "fleshtimer/1.3.0+1 (macos)",
      "version": "1.3.0.1",
      "expected": false
    },
    {
      "clientVersion": null,
      "version": "99.0",
      "expected": true
    },
    {
      "clientVersion": "garbage",
      "version": "99.0",
      "expected": true
    }
  ]
}
